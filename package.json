{
	"name": "projetos-2",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"setup": "bunx --bun tsx scripts/setup.ts",
		"frontend:dev": "cd apps/frontend && bun run dev",
		"frontend:build": "cd apps/frontend && bun run build",
		"frontend:start": "cd apps/frontend && bun run start",
		"backend:dev": "bunx --bun tsx scripts/dev-backend.ts"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"@types/node": "^26.5.1"
	}
}
