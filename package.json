{
	"name": "projetos-2",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"setup": "bun scripts/setup.ts",
		"dev": "bun scripts/dev.ts",
		"frontend:dev": "cd apps/frontend && bun --bun run dev",
		"frontend:build": "cd apps/frontend && bun run build",
		"frontend:start": "cd apps/frontend && bun --bun run start",
		"backend:dev": "bunx --bun tsx scripts/dev-backend.ts",
		"build": "bun scripts/build.ts",
		"start": "bun scripts/start.ts",
		"e2e": "bun scripts/e2e.ts",
		"e2e:demo": "bun scripts/e2e.ts --demo"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.90.0"
	},
	"peerDependencies": {
		"typescript": "^7.1.0-beta"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-serif-georgian": "^5.3.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"@types/node": "^26.6.5"
	}
}
