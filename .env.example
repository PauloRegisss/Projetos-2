# URL publica do backend usada pelo frontend e pelo navegador.
WAKU_PUBLIC_BACKEND_URL="https://api.exemplo.com"

# Configuracao do Django.
SECRET_KEY="gere-uma-chave-longa-e-segura"
DEBUG=False
ALLOWED_HOSTS="api.exemplo.com"
CORS_ALLOWED_ORIGINS="https://app.exemplo.com"
CSRF_TRUSTED_ORIGINS="https://app.exemplo.com"
DATABASE_URL="sqlite:///apps/backend/db.sqlite3"
SESSION_COOKIE_SECURE=True

# Configuracao dos processos de producao.
BACKEND_PORT=8000
FRONTEND_PORT=3000
GUNICORN_WORKERS=3
